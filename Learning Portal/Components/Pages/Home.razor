@page "/"
@rendermode InteractiveServer
@using Syncfusion.Blazor.Charts
@inject SampleDataService Data
@implements IDisposable

<PageTitle>Dashboard — Professional Learning Portal</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">Dashboard</h1>
        <p class="page-subtitle">Portfolio overview of courses, learners, and completion performance.</p>
    </div>
    <div class="page-header-actions">
        <span class="topbar-badge">Academic Year 2025–26</span>
    </div>
</div>

<div class="card-grid kpi-grid">
    @foreach (var kpi in _kpis)
    {
        <div class="kpi-card">
            <span class="kpi-icon" style="background:@kpi.IconBg;color:@kpi.IconColor" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">@((MarkupString)kpi.Icon)</svg>
            </span>
            <div>
                <div class="kpi-value">@kpi.Value</div>
                <div class="kpi-label">@kpi.Label</div>
                <div class="kpi-trend @kpi.TrendDirection">@kpi.Trend</div>
            </div>
        </div>
    }
</div>

<div class="card-grid" style="grid-template-columns:2fr 1fr;margin-top:16px">
    <div class="panel chart-panel">
        <h2 class="panel-title">Monthly Enrollments vs Completions</h2>
        <SfChart Title=" " Width="100%" Height="340px">
            <ChartPrimaryXAxis ValueType="Syncfusion.Blazor.Charts.ValueType.Category"></ChartPrimaryXAxis>
            <ChartSeriesCollection>
                <ChartSeries Type="Syncfusion.Blazor.Charts.ChartSeriesType.Column" XName="Month" YName="Enrollments" Name="Enrollments" DataSource="@_monthly">
                    <ChartMarker Visible="true"></ChartMarker>
                </ChartSeries>
                <ChartSeries Type="Syncfusion.Blazor.Charts.ChartSeriesType.Line" XName="Month" YName="Completions" Name="Completions" Width="2" DataSource="@_monthly">
                    <ChartMarker Visible="true"></ChartMarker>
                </ChartSeries>
            </ChartSeriesCollection>
            <ChartLegendSettings Visible="true" Position="LegendPosition.Bottom"></ChartLegendSettings>
            <ChartTooltipSettings Enable="true"></ChartTooltipSettings>
        </SfChart>
    </div>
    <div class="panel chart-panel">
        <h2 class="panel-title">Enrollments by Category</h2>
        <SfAccumulationChart Title=" " Width="100%" Height="340px">
            <AccumulationChartSeriesCollection>
                <AccumulationChartSeries Type="AccumulationType.Pie" XName="Category" YName="Count" DataSource="@_byCategory">
                    <AccumulationDataLabelSettings Visible="true" Name="Category"></AccumulationDataLabelSettings>
                </AccumulationChartSeries>
            </AccumulationChartSeriesCollection>
            <AccumulationChartLegendSettings Visible="true" Position="LegendPosition.Bottom"></AccumulationChartLegendSettings>
            <AccumulationChartTooltipSettings Enable="true"></AccumulationChartTooltipSettings>
        </SfAccumulationChart>
    </div>
</div>

<div class="panel" style="margin-top:16px">
    <h2 class="panel-title">Recent Enrollments</h2>
    <SfGrid @ref="_grid" TValue="Enrollment" DataSource="@_recent" AllowPaging="true" AllowSorting="true">
        <GridPageSettings PageSize="8"></GridPageSettings>
        <GridColumns>
            <GridColumn Field="@nameof(Enrollment.LearnerName)" HeaderText="Learner" Width="160"></GridColumn>
            <GridColumn Field="@nameof(Enrollment.CourseTitle)" HeaderText="Course" Width="230"></GridColumn>
            <GridColumn Field="@nameof(Enrollment.District)" HeaderText="District" Width="150"></GridColumn>
            <GridColumn Field="@nameof(Enrollment.EnrolledDate)" HeaderText="Enrolled" Format="d" Type="Syncfusion.Blazor.Grids.ColumnType.DateTime" Width="120"></GridColumn>
            <GridColumn Field="@nameof(Enrollment.ProgressPercent)" HeaderText="Progress %" Width="130"></GridColumn>
        </GridColumns>
    </SfGrid>
</div>

@code {
    private List<KpiStat> _kpis = [];
    private List<MonthlyEnrollmentPoint> _monthly = [];
    private List<CategoryCount> _byCategory = [];
    private List<Enrollment> _recent = [];
    private SfGrid<Enrollment>? _grid;

    private class KpiStat
    {
        public string Value { get; set; } = "";
        public string Label { get; set; } = "";
        public string Trend { get; set; } = "";
        public string TrendDirection { get; set; } = "up";
        public string Icon { get; set; } = "";
        public string IconBg { get; set; } = "";
        public string IconColor { get; set; } = "";
    }

    private record CategoryCount(string Category, int Count);

    protected override async Task OnInitializedAsync()
    {
        var courses = await Data.GetCoursesAsync();
        var enrollments = await Data.GetEnrollmentsAsync();
        _monthly = await Data.GetMonthlyEnrollmentsAsync();
        _recent = await Data.GetRecentEnrollmentsAsync();

        _byCategory = enrollments
            .GroupBy(e => e.Category)
            .Select(g => new CategoryCount(g.Key, g.Count()))
            .ToList();

        var activeLearners = enrollments.Select(e => e.LearnerEmail).Distinct().Count();
        var completions = enrollments.Count(e => e.Completed);
        var avgProgress = enrollments.Count > 0 ? enrollments.Average(e => e.ProgressPercent) : 0;

        _kpis =
        [
            new KpiStat { Value = courses.Count.ToString(), Label = "Active Courses", Trend = "▲ 2 vs last term",
                Icon = "<path d='M22 10L12 5 2 10l10 5 10-5z'/><path d='M6 12v5c0 1.7 2.7 3 6 3s6-1.3 6-3v-5'/><path d='M22 10v6'/>",
                IconBg = "#eaf3fc", IconColor = "#0b5cab" },
            new KpiStat { Value = activeLearners.ToString(), Label = "Active Learners", Trend = "▲ 12% growth",
                Icon = "<path d='M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2'/><circle cx='9' cy='7' r='4'/><path d='M23 21v-2a4 4 0 00-3-3.87'/><path d='M16 3.13a4 4 0 010 7.75'/>",
                IconBg = "#e8f7ee", IconColor = "#1a7f4b" },
            new KpiStat { Value = $"{avgProgress:0}%", Label = "Avg. Learner Progress", Trend = "▲ 4 pts this month",
                Icon = "<path d='M23 6l-9.5 9.5-5-5L1 18'/><path d='M17 6h6v6'/>",
                IconBg = "#fdf3e7", IconColor = "#b26a00" },
            new KpiStat { Value = completions.ToString(), Label = "Completions (YTD)", Trend = "▲ 8% vs last year",
                Icon = "<path d='M22 11.08V12a10 10 0 11-5.93-9.14'/><path d='M22 4L12 14.01l-3-3'/>",
                IconBg = "#f3ecfa", IconColor = "#6d3fa4" },
        ];
    }

    public void Dispose() => _grid?.Dispose();
}

